# Cloudflare Workers AI Configuration
# Obtain your API Token from: https://dash.cloudflare.com/profile/api-tokens
# (Workers AI Read/Edit permissions required)
CLOUDFLARE_API_TOKEN=cfut_your_token_here

# Cloudflare Account ID:
# Found in the Cloudflare Dashboard right sidebar under Workers & Pages, or in the dashboard URL
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Model: @cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# VisionQA Environment Configuration
# Copy this file to .env and insert your real Gemini API key.

# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Multimodal Gemini model to use
# Recommended models:
# - gemini-flash-lite-latest (fast, active multimodal vision model)
# - gemini-3.1-flash-lite    (efficient next-generation model)
# - gemini-pro-latest         (advanced visual reasoning)
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: Maximum conversation history turns to send to the model (prevents token bloat)
MAX_HISTORY_TURNS=10

# AI Provider: 'gemini' or 'ollama' (default: gemini)
AI_PROVIDER=gemini

# Local Ollama Settings (Optional, when using local models)
# Requires Ollama running locally (https://ollama.com/)
# Recommended vision models: llama3.2-vision, llava, moondream, minicpm-v
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision

# Optional: Persistent history SQLite database path
SQLITE_DB_PATH=visionqa_history.db
